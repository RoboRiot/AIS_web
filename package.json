{
  "name": "advanced-imaging",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-release.mjs",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test tests/*.test.mjs",
    "verify:build": "node scripts/verify-build-assets.mjs",
    "verify:site": "node scripts/verify-site-assets.mjs",
    "audit:product-links": "node scripts/audit-product-links.mjs",
    "catalog:ge:audit": "node scripts/import-oem-catalog.mjs --oem=GE --audit-live",
    "catalog:ge:verify": "node scripts/import-oem-catalog.mjs --oem=GE --verify",
    "catalog:siemens:audit": "node scripts/import-oem-catalog.mjs --oem=Siemens --audit-live",
    "catalog:siemens:verify": "node scripts/import-oem-catalog.mjs --oem=Siemens --verify",
    "catalog:toshiba:audit": "node scripts/import-oem-catalog.mjs --oem=Toshiba --audit-live",
    "catalog:toshiba:verify": "node scripts/import-oem-catalog.mjs --oem=Toshiba --verify",
    "catalog:philips:audit": "node scripts/import-oem-catalog.mjs --oem=Philips --audit-live",
    "catalog:philips:verify": "node scripts/import-oem-catalog.mjs --oem=Philips --verify"
  },
  "dependencies": {
    "aos": "^2.3.4",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.10.0",
    "lightgallery": "^2.7.2",
    "next": "^14.2.35",
    "react": "^18.2.0",
    "react-dom": "^18",
    "react-google-recaptcha": "^3.1.0",
    "react-google-recaptcha-v3": "^1.10.1",
    "react-outside-click-handler": "^1.3.0",
    "sass": "^1.70.0",
    "sharp": "^0.33.2",
    "swiper": "^12.2.0"
  },
  "devDependencies": {
    "eslint": "^8",
    "eslint-config-next": "^14.2.35"
  }
}
